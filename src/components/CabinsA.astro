---
// Las cabañas, ronda 1, variante A: rejilla editorial asimétrica (12 columnas). Brief en cabanas.md.
// El orden del DOM es el orden visual (foco y vista ampliada siguen lo que se ve).
import { es } from '../content/es';
import CabinsHead from './cabins/CabinsHead.astro';
import CabinsPhoto from './cabins/CabinsPhoto.astro';
import CabinsDetail from './cabins/CabinsDetail.astro';
import CabinsViewer from './cabins/CabinsViewer.astro';
---

<section class="cabins section" id="cabanas" aria-labelledby="cabanas-titulo">
	<div class="container">
		<CabinsHead />

		<div class="gallery">
			<div class="cell living">
				<CabinsPhoto photo="living" sizes="(min-width: 76rem) 40rem, (min-width: 48rem) 56vw, 100vw" />
			</div>
			<div class="cell camas">
				<CabinsPhoto photo="dormitorioDosCamas" sizes="(min-width: 76rem) 28rem, (min-width: 48rem) 40vw, 100vw" />
			</div>
			<div class="cell cocina">
				<CabinsPhoto photo="cocina" sizes="(min-width: 76rem) 28rem, (min-width: 48rem) 40vw, 100vw" />
			</div>
			<div class="cell matrimonial">
				<CabinsPhoto photo="dormitorioMatrimonial" sizes="(min-width: 76rem) 22rem, (min-width: 48rem) 32vw, 100vw" />
			</div>
			<div class="cell bano">
				<CabinsPhoto photo="bano" sizes="(min-width: 76rem) 16rem, (min-width: 48rem) 24vw, 100vw" />
			</div>
		</div>

		<p class="note">{es.cabins.photoNote}</p>

		<div class="detail"><CabinsDetail /></div>
	</div>

	<CabinsViewer />
</section>

<style>
	.cabins {
		background: var(--bg);
		color: var(--text);
	}

	.gallery {
		display: grid;
		gap: var(--space-12);
		margin-top: var(--space-16);
	}

	/* Una columna: cada foto con su proporción y sin pasar de su resolución */
	.cell {
		max-width: var(--photo-max-width);
	}

	.note {
		margin-top: var(--space-8);
		font-size: var(--text-xs);
		line-height: var(--leading-snug);
		color: var(--text-muted);
	}

	.detail {
		margin-top: var(--space-24);
		padding-top: var(--space-12);
		border-top: var(--border-width) solid var(--line-on-light);
	}

	@media (min-width: 48rem) {
		.gallery {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: var(--space-8);
			align-items: start;
		}

		.cell {
			max-width: none;
		}

		.living {
			grid-column: 1 / span 7;
		}

		.camas {
			grid-column: 8 / span 5;
		}

		/* Segunda fila alineada por abajo: las alturas distintas escalonan la parte de arriba */
		.cocina {
			grid-column: 1 / span 5;
			align-self: end;
		}

		.matrimonial {
			grid-column: 6 / span 4;
			align-self: end;
		}

		.bano {
			grid-column: 10 / span 3;
			align-self: end;
		}

		.note {
			font-size: var(--text-sm);
		}
	}
</style>

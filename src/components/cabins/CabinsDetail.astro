---
import CabinsIncluded from './CabinsIncluded.astro';
import CabinsPanel from './CabinsPanel.astro';
---

<div class="detail">
	<div class="included"><CabinsIncluded /></div>
	<div class="panel"><CabinsPanel /></div>
</div>

<style>
	.detail {
		display: grid;
		gap: var(--space-12);
	}

	/* La lista se lee de punta a punta antes de llegar a la ficha: solo van lado a lado donde cabe el botón */
	@media (min-width: 64rem) {
		.detail {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: var(--space-8);
			align-items: start;
		}

		.included {
			grid-column: 1 / span 7;
		}

		.panel {
			grid-column: 8 / span 5;
		}
	}
</style>

---
import '@fontsource/cormorant-garamond/latin-300.css';
import { es } from '../../content/es';

const { cabins } = es;
---

<header class="head">
	<h2 id="cabanas-titulo" class="title">{cabins.title}</h2>
	<p class="intro">{cabins.intro}</p>
</header>

<style>
	/* Familia, peso, interlínea y tracking vienen de global.css (h1–h3), igual que el titular del hero */
	.head {
		display: grid;
		gap: var(--space-6);
		padding-bottom: var(--space-8);
		border-bottom: var(--border-width) solid var(--line-on-light);
	}

	.title {
		font-size: var(--step-section);
		text-transform: uppercase;
		text-wrap: balance;
		color: var(--text);
	}

	.intro {
		max-width: var(--measure-narrow);
		color: var(--text-muted);
	}

	@media (min-width: 48rem) {
		.head {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: var(--space-8);
			align-items: end;
		}

		.title {
			grid-column: 1 / span 6;
		}

		.intro {
			grid-column: 8 / span 5;
		}
	}
</style>

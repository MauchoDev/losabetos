---
import { Picture } from 'astro:assets';
import { es } from '../../content/es';
import { sources, viewerSrc, type PhotoKey } from './photos';

interface Props {
	photo: PhotoKey;
	sizes: string;
	// 'width': ocupa el ancho de su celda (rejilla). 'height': alto fijo de --strip-h (fila con scroll).
	fit?: 'width' | 'height';
}

const { photo, sizes, fit = 'width' } = Astro.props;
const slot = es.photos[photo];
const full = await viewerSrc(photo);
---

<figure class:list={['photo', fit]}>
	<button
		type="button"
		class="open"
		aria-haspopup="dialog"
		aria-label={`${es.cabins.openPhoto}: ${slot.caption}`}
		data-viewer-item
		data-full={full}
		data-alt={slot.alt}
		data-caption={slot.caption}
		data-width={slot.width}
		data-height={slot.height}
	>
		<Picture
			src={sources[photo]}
			alt={slot.alt}
			width={slot.width}
			height={slot.height}
			formats={['avif', 'webp']}
			widths={[480, 960, slot.width]}
			sizes={sizes}
		/>
	</button>
	<figcaption>{slot.caption}</figcaption>
</figure>

<style>
	.photo {
		margin: 0;
	}

	.open {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		border-radius: var(--radius-photo);
		overflow: hidden;
		background: var(--bg-alt);
		cursor: zoom-in;
	}

	.open :global(img) {
		width: 100%;
		height: auto;
		filter: var(--photo-hero-filter);
	}

	/* Fila con scroll: alto fijo, el ancho sale de la proporción de cada foto */
	.height .open {
		width: auto;
		height: var(--strip-h);
	}

	.height .open :global(img) {
		width: auto;
		max-width: none;
		height: 100%;
	}

	figcaption {
		margin-top: var(--space-3);
		font-size: var(--text-xs);
		line-height: var(--leading-snug);
		color: var(--text-muted);
	}

	@media (min-width: 48rem) {
		figcaption {
			font-size: var(--text-sm);
		}
	}
</style>

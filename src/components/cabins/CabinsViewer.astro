---
import { es } from '../../content/es';

const { viewer } = es.cabins;
---

<dialog class="viewer" aria-label={viewer.label} data-viewer>
	<button type="button" class="ctrl close" aria-label={viewer.close} data-viewer-close>
		<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18"></path></svg>
	</button>

	<figure class="stage">
		<img alt="" data-viewer-img />
		<figcaption data-viewer-caption aria-live="polite"></figcaption>
	</figure>

	<button type="button" class="ctrl prev" aria-label={viewer.prev} data-viewer-prev>
		<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 12H4M10.5 5.5 4 12l6.5 6.5"></path></svg>
	</button>
	<button type="button" class="ctrl next" aria-label={viewer.next} data-viewer-next>
		<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h16M13.5 5.5 20 12l-6.5 6.5"></path></svg>
	</button>
</dialog>

<style>
	.viewer {
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: var(--gutter);
		border: 0;
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	.viewer[open] {
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-template-rows: auto minmax(0, 1fr) auto;
		grid-template-areas:
			'close close'
			'stage stage'
			'prev next';
		gap: var(--space-4);
	}

	.close {
		grid-area: close;
		justify-self: end;
	}

	.prev {
		grid-area: prev;
		justify-self: start;
	}

	.next {
		grid-area: next;
		justify-self: end;
	}

	.stage {
		grid-area: stage;
		display: grid;
		grid-template-rows: minmax(0, 1fr) auto;
		justify-items: center;
		gap: var(--space-4);
		min-height: 0;
		margin: 0;
	}

	/* El tamaño parte de width y height del slot: la foto nunca se muestra más grande que su archivo */
	.stage img {
		align-self: center;
		width: auto;
		height: auto;
		max-width: 100%;
		max-height: 100%;
		min-height: 0;
		object-fit: contain;
		border-radius: var(--radius-photo);
		filter: var(--photo-hero-filter);
	}

	figcaption {
		font-size: var(--text-sm);
		color: var(--text-on-dark-muted);
	}

	/* Botón circular: el mismo del hero (HeroScroll), sin transición en esta sección */
	.ctrl {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--control-lg);
		height: var(--control-lg);
		padding: 0;
		border: var(--border-width) solid var(--line-on-dark);
		border-radius: var(--radius-pill);
		background: transparent;
		color: var(--text-on-dark);
		cursor: pointer;
	}

	.ctrl:hover {
		background: var(--text-on-dark);
		color: var(--cta-text);
	}

	.ctrl svg {
		width: var(--space-6);
		height: var(--space-6);
		fill: none;
		stroke: currentColor;
		stroke-width: var(--stroke-icon);
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.ctrl svg :global(path) {
		vector-effect: non-scaling-stroke;
	}

	@media (min-width: 48rem) {
		.viewer[open] {
			grid-template-columns: auto minmax(0, 1fr) auto;
			grid-template-rows: auto minmax(0, 1fr);
			grid-template-areas:
				'close close close'
				'prev stage next';
			align-items: center;
		}

		.stage {
			height: 100%;
		}
	}

	/* Con la vista abierta, la página de atrás no se mueve */
	:global(body:has(dialog[data-viewer][open])) {
		overflow: hidden;
	}
</style>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('[data-viewer]');

	if (dialog) {
		const items = Array.from(document.querySelectorAll<HTMLElement>('[data-viewer-item]'));
		const img = dialog.querySelector<HTMLImageElement>('[data-viewer-img]')!;
		const caption = dialog.querySelector<HTMLElement>('[data-viewer-caption]')!;
		const close = dialog.querySelector<HTMLButtonElement>('[data-viewer-close]')!;
		const prev = dialog.querySelector<HTMLButtonElement>('[data-viewer-prev]')!;
		const next = dialog.querySelector<HTMLButtonElement>('[data-viewer-next]')!;
		const controls = [close, prev, next];
		let index = 0;
		let opener: HTMLElement | null = null;

		const show = (i: number) => {
			index = (i + items.length) % items.length;
			const { full, alt, caption: text, width, height } = items[index].dataset;
			img.src = full ?? '';
			img.alt = alt ?? '';
			img.width = Number(width);
			img.height = Number(height);
			caption.textContent = text ?? '';
			// Las vecinas se piden antes para que el cambio no espere la red
			for (const n of [index - 1, index + 1]) {
				new Image().src = items[(n + items.length) % items.length].dataset.full ?? '';
			}
		};

		items.forEach((item, i) => {
			item.addEventListener('click', () => {
				opener = item;
				show(i);
				dialog.showModal();
			});
		});

		close.addEventListener('click', () => dialog.close());
		prev.addEventListener('click', () => show(index - 1));
		next.addEventListener('click', () => show(index + 1));

		// Clic fuera de la foto y de los botones (en el fondo del diálogo) cierra la vista
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) dialog.close();
		});

		dialog.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') show(index - 1);
			else if (e.key === 'ArrowRight') show(index + 1);
			else if (e.key === 'Tab') {
				// Foco atrapado: Tab recorre solo cerrar, anterior y siguiente
				const first = controls[0];
				const last = controls[controls.length - 1];
				if (e.shiftKey && document.activeElement === first) {
					e.preventDefault();
					last.focus();
				} else if (!e.shiftKey && document.activeElement === last) {
					e.preventDefault();
					first.focus();
				}
			}
		});

		dialog.addEventListener('close', () => opener?.focus());
	}
</script>

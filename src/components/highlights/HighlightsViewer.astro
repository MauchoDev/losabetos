---
import { es } from '../../content/es';
import { viewerOrder, viewerSrc } from './photos';
import arrowLeft from '../../assets/icons/arrow-left.svg?raw';
import arrowRight from '../../assets/icons/arrow-right.svg?raw';

const { viewer } = es.highlights;
// Flechas de Lucide copiadas a src/assets/icons (ver LICENSE-lucide.txt); el CSS les pone trazo fino y esquinas rectas
const decorative = (svg: string) => svg.replace(/class="[^"]*"/, 'aria-hidden="true" focusable="false"');
// Las 5 fotos, también las que no tienen tarjeta. Cada disparador (`data-viewer-open="clave"`) abre la suya.
const items = await Promise.all(
	viewerOrder.map(async (key) => ({ key, slot: es.photos[key], full: await viewerSrc(key) })),
);
---

<dialog class="viewer" aria-label={viewer.label} data-viewer>
	<ul hidden>
		{
			items.map(({ key, slot, full }) => (
				<li
					data-viewer-item={key}
					data-full={full}
					data-alt={slot.alt}
					data-caption={slot.caption}
					data-width={slot.width}
					data-height={slot.height}
				/>
			))
		}
	</ul>

	<button type="button" class="ctrl close" data-viewer-close>{viewer.close}</button>

	<figure class="stage">
		<img alt="" data-viewer-img />
		<figcaption data-viewer-caption aria-live="polite"></figcaption>
	</figure>

	<button type="button" class="ctrl prev" aria-label={viewer.prev} data-viewer-prev>
		<Fragment set:html={decorative(arrowLeft)} />
	</button>
	<button type="button" class="ctrl next" aria-label={viewer.next} data-viewer-next>
		<Fragment set:html={decorative(arrowRight)} />
	</button>
</dialog>

<style>
	.viewer {
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: var(--gutter);
		border: 0;
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	.viewer[open] {
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-template-rows: auto minmax(0, 1fr) auto;
		grid-template-areas:
			'close close'
			'stage stage'
			'prev next';
		gap: var(--space-4);
	}

	.close {
		grid-area: close;
		justify-self: end;
	}

	.prev {
		grid-area: prev;
		justify-self: start;
	}

	.next {
		grid-area: next;
		justify-self: end;
	}

	.stage {
		grid-area: stage;
		display: grid;
		grid-template-rows: minmax(0, 1fr) auto;
		justify-items: center;
		gap: var(--space-4);
		min-height: 0;
		margin: 0;
	}

	/* La foto nunca se muestra por encima de su resolución real: --cap-w y --cap-h son el ancho y el alto del archivo
	   en px CSS (px del archivo ÷ densidad de píxeles de la pantalla; los pone el script al abrir cada foto) */
	.stage img {
		align-self: center;
		width: auto;
		height: auto;
		max-width: min(100%, var(--cap-w, 100%));
		max-height: min(100%, var(--cap-h, 100%));
		min-height: 0;
		object-fit: contain;
		border-radius: var(--radius-square);
		filter: var(--photo-hero-filter);
	}

	figcaption {
		font-size: var(--text-sm);
		color: var(--text-on-dark-muted);
	}

	/* Controles: de 48 px de alto y bordes rectos de 1 px (no circulares, a diferencia del hero). Las flechas son
	   cuadradas de 48 px; «Cerrar» es del mismo alto y lleva texto. */
	.ctrl {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: var(--control-square);
		height: var(--control-square);
		padding: 0;
		border: var(--border-width) solid var(--line-on-dark);
		border-radius: var(--radius-square);
		background: transparent;
		color: var(--text-on-dark);
		cursor: pointer;
	}

	.ctrl:hover {
		background: var(--text-on-dark);
		color: var(--bg-dark);
	}

	.close {
		padding-inline: var(--space-6);
		font: inherit;
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: var(--tracking-caps);
	}

	.ctrl :global(svg) {
		width: var(--space-6);
		height: var(--space-6);
		stroke-width: var(--stroke-lucide);
		stroke-linecap: square;
		stroke-linejoin: miter;
	}

	@media (min-width: 48rem) {
		.viewer[open] {
			grid-template-columns: auto minmax(0, 1fr) auto;
			grid-template-rows: auto minmax(0, 1fr);
			grid-template-areas:
				'close close close'
				'prev stage next';
			align-items: center;
		}

		.stage {
			height: 100%;
		}
	}

	/* Con la vista abierta, la página de atrás no se mueve */
	:global(body:has(dialog[data-viewer][open])) {
		overflow: hidden;
	}
</style>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('[data-viewer]');

	if (dialog) {
		const items = Array.from(dialog.querySelectorAll<HTMLElement>('[data-viewer-item]'));
		const img = dialog.querySelector<HTMLImageElement>('[data-viewer-img]')!;
		const caption = dialog.querySelector<HTMLElement>('[data-viewer-caption]')!;
		const close = dialog.querySelector<HTMLButtonElement>('[data-viewer-close]')!;
		const prev = dialog.querySelector<HTMLButtonElement>('[data-viewer-prev]')!;
		const next = dialog.querySelector<HTMLButtonElement>('[data-viewer-next]')!;
		const controls = [close, prev, next];
		let index = 0;
		let opener: HTMLElement | null = null;

		// Tope de resolución: píxeles del archivo ÷ píxeles físicos por px CSS (1 en pantalla normal, 2 en retina)
		const capResolution = () => {
			const { width, height } = items[index].dataset;
			img.style.setProperty('--cap-w', `${Number(width) / window.devicePixelRatio}px`);
			img.style.setProperty('--cap-h', `${Number(height) / window.devicePixelRatio}px`);
		};

		const show = (i: number) => {
			index = (i + items.length) % items.length;
			const { full, alt, caption: text, width, height } = items[index].dataset;
			img.src = full ?? '';
			img.alt = alt ?? '';
			img.width = Number(width);
			img.height = Number(height);
			capResolution();
			caption.textContent = text ?? '';
			// Las vecinas se piden antes para que el cambio no espere la red
			for (const n of [index - 1, index + 1]) {
				new Image().src = items[(n + items.length) % items.length].dataset.full ?? '';
			}
		};

		// Cada disparador lleva la clave de su foto; la vista abre en esa foto
		document.querySelectorAll<HTMLElement>('[data-viewer-open]').forEach((trigger) => {
			trigger.addEventListener('click', () => {
				const at = items.findIndex((item) => item.dataset.viewerItem === trigger.dataset.viewerOpen);
				opener = trigger;
				show(Math.max(at, 0));
				dialog.showModal();
			});
		});

		// El zoom del navegador cambia la densidad de píxeles: el tope se recalcula con la vista abierta
		window.addEventListener('resize', () => {
			if (dialog.open) capResolution();
		});

		close.addEventListener('click', () => dialog.close());
		prev.addEventListener('click', () => show(index - 1));
		next.addEventListener('click', () => show(index + 1));

		// Clic fuera de la foto y de los botones (en el fondo del diálogo) cierra la vista
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) dialog.close();
		});

		dialog.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') show(index - 1);
			else if (e.key === 'ArrowRight') show(index + 1);
			else if (e.key === 'Tab') {
				// Foco atrapado: Tab recorre solo cerrar, anterior y siguiente
				const first = controls[0];
				const last = controls[controls.length - 1];
				if (e.shiftKey && document.activeElement === first) {
					e.preventDefault();
					last.focus();
				} else if (!e.shiftKey && document.activeElement === last) {
					e.preventDefault();
					first.focus();
				}
			}
		});

		dialog.addEventListener('close', () => opener?.focus());
	}
</script>

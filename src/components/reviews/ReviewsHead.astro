---
import '@fontsource/cormorant-garamond/latin-300.css';
import { es } from '../../content/es';
import arrowRight from '../../assets/icons/arrow-right.svg?raw';

// Patrón 1 de la sección 2 (HighlightsHead.astro) copiado sobre fondo oscuro. Todavía no hay versión genérica: no se
// abstrae sin tocar la sección 2, que está congelada (ver «Pendientes tras la sección 3» en BACKLOG.md).
const { title, linkLabel } = es.reviews;
const { airbnbUrl } = es.booking;
// TODO: booking.airbnbUrl está en null (es.ts). Hasta tenerla, el texto se ve pero no enlaza (igual que en el hero).
---

<header class="head">
	<h2 id="resenas-titulo" class="title">{title}</h2>
	<a
		class="link"
		href={airbnbUrl ?? undefined}
		target={airbnbUrl ? '_blank' : undefined}
		rel={airbnbUrl ? 'noopener' : undefined}
	>
		<span class="label">{linkLabel}</span>
		<Fragment set:html={arrowRight.replace(/class="[^"]*"/, 'class="arrow" aria-hidden="true" focusable="false"')} />
	</a>
</header>

<style>
	/* Familia, peso, interlínea y tracking vienen de global.css (h1–h3). Mismo estilo y tamaño que Lo que destaca. */
	.title {
		font-size: var(--step-section);
		text-transform: uppercase;
		text-wrap: balance;
		color: var(--text-on-dark);
	}

	.head {
		display: grid;
		gap: var(--space-2);
	}

	.link {
		display: inline-block;
		justify-self: start;
		padding-block: var(--space-4);
		color: var(--text-on-dark);
		font-size: var(--text-xs);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-caps);
		text-transform: uppercase;
		text-decoration: none;
	}

	.label {
		text-decoration: underline;
		text-decoration-thickness: var(--border-width);
		text-underline-offset: var(--space-2);
	}

	.link :global(.arrow) {
		width: var(--icon-size-sm);
		height: var(--icon-size-sm);
		margin-inline-start: var(--space-3);
		/* El trazo de Lucide deja ~4 px vacíos a la derecha del SVG: se compensan para que la punta quede en el borde del contenedor */
		margin-inline-end: calc(var(--icon-size-sm) * -0.2);
		vertical-align: middle;
		stroke-width: var(--stroke-lucide);
		stroke-linecap: square;
		stroke-linejoin: miter;
	}

	/* Hover solo si el enlace tiene destino (mientras booking.airbnbUrl sea null no responde) */
	@media (prefers-reduced-motion: no-preference) {
		.link :global(.arrow) {
			transition: transform var(--duration-fast) var(--ease-out);
		}

		.link[href]:hover :global(.arrow) {
			transform: translateX(var(--arrow-nudge));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.link[href]:hover .label {
			text-decoration-thickness: calc(var(--border-width) * 2);
		}
	}

	@media (min-width: 48rem) {
		.head {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: var(--space-8);
			align-items: end;
			/* Alinea la base del enlace con la de la última línea del titular */
			align-items: last baseline;
		}

		/* En tablet el titular ocupa 8 columnas y desde 76rem, 6 (igual que Lo que destaca) */
		.title {
			grid-column: 1 / span 8;
		}

		.link {
			grid-column: 9 / span 4;
			justify-self: end;
		}
	}

	@media (min-width: 76rem) {
		.title {
			grid-column: 1 / span 6;
		}
	}
</style>

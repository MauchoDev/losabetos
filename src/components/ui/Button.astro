---
// Botones de formas rectas para todo lo que no es el hero (DESTACADOS-BRIEF.md). Con `href` es un enlace; sin él,
// un <button type="button"> que abre algo (por ejemplo la vista ampliada). El texto va en el slot y sale de es.ts.
// El secundario es para fondos claros: contorno y relleno en pino.
interface Props {
	variant?: 'primary' | 'secondary';
	href?: string;
	// En móvil ocupa todo el ancho
	wide?: boolean;
	[attr: string]: unknown;
}

const { variant = 'primary', href, wide = false, ...attrs } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
	class:list={['btn', variant, { wide }]}
	href={href}
	type={href ? undefined : 'button'}
	{...attrs}
>
	<slot />
</Tag>

<style>
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: var(--control-lg);
		padding: 0 var(--space-8);
		border: var(--border-width) solid transparent;
		border-radius: var(--radius-square);
		font-family: inherit;
		font-size: var(--text-xs);
		font-weight: var(--weight-strong);
		line-height: var(--leading-snug);
		text-align: center;
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: var(--tracking-caps);
		cursor: pointer;
		transition:
			background var(--duration-fast) var(--ease-out),
			color var(--duration-fast) var(--ease-out);
	}

	.wide {
		width: 100%;
	}

	/* Ámbar del hero (--cta-bg), texto en pino. Hover: el fondo se oscurece, sin escala ni sombra. */
	.primary {
		background: var(--cta-bg);
		border-color: var(--cta-bg);
		color: var(--cta-text);
	}

	.primary:hover {
		background: var(--cta-bg-hover);
		border-color: var(--cta-bg-hover);
	}

	/* Contorno de 1 px en pino y fondo transparente. Hover: se rellena de pino. */
	.secondary {
		background: transparent;
		border-color: var(--text);
		color: var(--text);
	}

	.secondary:hover {
		background: var(--text);
		color: var(--text-on-dark);
	}

	@media (min-width: 48rem) {
		.wide {
			width: auto;
		}
	}
</style>
